                border: 1px solid #37585a;
                border-radius: 10px;
                background: #173a3d;
                color: #f1f8f7;
                font-size: 11px;
                box-shadow: 0 12px 30px #0c262933;
                opacity: 0;
                transform: translateY(8px);

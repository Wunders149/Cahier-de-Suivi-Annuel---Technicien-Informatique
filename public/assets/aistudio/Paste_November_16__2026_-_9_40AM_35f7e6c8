<!doctype html>
<html lang="fr">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#173a3d">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-title" content="SOGEDIPROMA">
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
        <link rel="manifest" href="/manifest.webmanifest">
        <link rel="icon" type="image/png" sizes="192x192" href="/icons/sogediproma-192.png">
        <link rel="apple-touch-icon" href="/icons/sogediproma-180.png">
        <title>SOGEDIPROMA · Gestion informatique</title>
        <style>
            .search-select {
                position: relative;
                width: 100%;
                min-width: 0
            }

            .search-select::after {
                content: "⌄";
                position: absolute;
                right: 11px;
                top: 4px;
                color: var(--muted);
                pointer-events: none;
                font-size: 15px
            }

            .search-select.is-open::after {
                content: "⌃"
            }

            .search-select-input {
                width: 100%;
                min-width: 0;
                padding-right: 30px!important;
                text-overflow: ellipsis
            }

            .search-select-options {
                position: absolute;
                z-index: 130;
                top: calc(100% + 4px);
                left: 0;
                right: 0;
                max-height: 220px;
                overflow: auto;
                padding: 4px;
                border: 1px solid var(--line);
                border-radius: 9px;
                background: var(--surface);
                box-shadow: 0 10px 26px #142b2b24
            }

            .search-select.opens-up .search-select-options {
                top: auto;
                bottom: calc(100% + 4px)
            }

            .search-select-option {
                display: block;
                width: 100%;
                min-height: 32px;
                padding: 7px 9px;
                border: 0;
                border-radius: 6px;
                background: transparent;
                color: var(--ink);
                text-align: left;
                font: inherit;
                font-size: 11px;
                cursor: pointer
            }

            .search-select-option:hover,.search-select-option[aria-selected=true] {
                background: var(--brand-soft);
                color: var(--brand-dark)
            }

            .search-select-option:disabled {
                opacity: .45;
                cursor: not-allowed
            }

            .search-select-empty {
                padding: 9px;
                color: var(--muted);
                font-size: 11px
            }

            .search-select-native {
                position: absolute!important;
                width: 1px!important;
                height: 1px!important;
                padding: 0!important;
                margin: -1px!important;
                overflow: hidden!important;
                clip: rect(0,0,0,0)!important;
                clip-path: inset(50%)!important;
                white-space: nowrap!important;
                border: 0!important
            }

            :root {
                --bg: #f2f5f6;
                --surface: #fff;
                --surface-2: #f8fafb;
                --ink: #25363b;
                --muted: #718187;
                --line: #e1e8e9;
                --brand: #176d66;
                --brand-dark: #124e4b;
                --brand-soft: #e5f2f0;
                --gold: #d39235;
                --red: #bd5555;
                --shadow: 0 8px 26px rgba(22,49,53,.055);
                --radius: 14px
            }

            * {
                box-sizing: border-box
            }

            html {
                scroll-behavior: smooth
            }

            body {
                margin: 0;
                background: var(--bg);
                color: var(--ink);
                font: 14px/1.5 Inter,"Segoe UI",Roboto,Arial,sans-serif
            }

            button,input,select,textarea {
                font: inherit
            }

            button {
                cursor: pointer
            }

            .app {
                min-height: 100vh;
                display: grid;
                grid-template-columns: 258px minmax(0,1fr)
            }

            .sidebar {
                position: sticky;
                top: 0;
                height: 100vh;
                display: flex;
                flex-direction: column;
                padding: 22px 14px 16px;
                background: #173a3d;
                color: #dbe8e8;
                z-index: 40;
                overflow: auto
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 0 10px 24px
            }

            .brand-mark {
                width: 39px;
                height: 39px;
                display: grid;
                place-items: center;
                border-radius: 12px;
                background: #31a393;
                color: #fff;
                font-weight: 800;
                font-size: 17px;
                box-shadow: 0 7px 18px #0c272a55
            }

            .brand-name {
                font-size: 15px;
                font-weight: 800;
                letter-spacing: .04em;
                color: #fff
            }

            .brand-caption {
                display: block;
                margin-top: 1px;
                font-size: 10px;
                color: #a9c1c2;
                letter-spacing: .02em
            }

            .org-pill {
                display: flex;
                align-items: center;
                gap: 8px;
                margin: 0 5px 22px;
                padding: 9px 10px;
                border: 1px solid #ffffff18;
                border-radius: 9px;
                background: #ffffff09;
                color: #c5d7d8;
                font-size: 11px
            }

            .org-dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: #6dd2a5;
                box-shadow: 0 0 0 3px #6dd2a522
            }

            .nav-label {
                padding: 0 11px;
                margin: 11px 0 7px;
                color: #88a5a7;
                text-transform: uppercase;
                letter-spacing: .11em;
                font-size: 9px;
                font-weight: 750
            }

            .nav {
                display: grid;
                gap: 4px
            }

            .nav-link {
                width: 100%;
                display: flex;
                align-items: center;
                gap: 12px;
                min-height: 42px;
                padding: 9px 11px;
                border: 0;
                border-radius: 9px;
                background: transparent;
                color: #c1d0d1;
                text-align: left;
                font-size: 12px;
                transition: background .15s,color .15s
            }

            .nav-link:hover {
                background: #ffffff12;
                color: #fff
            }

            .nav-link.active {
                background: #28504f;
                color: #fff;
                box-shadow: inset 3px 0 #53c3ae;
                font-weight: 700
            }

            .nav-icon {
                width: 20px;
                text-align: center;
                font-size: 15px;
                color: #9bb8b9
            }

            .nav-link.active .nav-icon {
                color: #a4eadb
            }

            .sidebar-footer {
                margin-top: auto;
                padding-top: 20px
            }

            .local-note {
                padding: 12px;
                border: 1px solid #ffffff18;
                border-radius: 10px;
                background: #ffffff09;
                color: #b6c9ca;
                font-size: 10px
            }

            .local-note b {
                display: block;
                color: #eef7f6;
                font-size: 11px;
                margin-bottom: 2px
            }

            .local-actions {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 7px;
                margin-top: 9px
            }

            .sidebar-btn {
                padding: 8px 7px;
                border: 1px solid #ffffff22;
                border-radius: 8px;
                background: transparent;
                color: #e2eeee;
                font-size: 10px;
                font-weight: 650
            }

            .sidebar-btn:hover {
                background: #ffffff14
            }

            .main {
                min-width: 0
            }

            .topbar {
                position: sticky;
                top: 0;
                z-index: 30;
                height: 66px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                padding: 0 clamp(18px,3vw,38px);
                background: rgba(255,255,255,.94);
                border-bottom: 1px solid var(--line);
                backdrop-filter: blur(12px)
            }

            .top-left {
                display: flex;
                align-items: center;
                gap: 13px;
                min-width: 0
            }

            .mobile-toggle,.theme-toggle {
                width: 36px;
                height: 36px;
                display: grid;
                place-items: center;
                border: 1px solid var(--line);
                border-radius: 9px;
                background: #fff;
                color: var(--ink)
            }

            .mobile-toggle {
                display: none
            }

            .breadcrumb {
                min-width: 0;
                color: #879499;
                font-size: 11px;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis
            }

            .breadcrumb strong {
                color: #314348;
                font-weight: 700
            }

            .top-right {
                display: flex;
                align-items: center;
                gap: 12px
            }

            .local-status {
                display: flex;
                align-items: center;
                gap: 7px;
                color: #65777b;
                font-size: 10px;
                white-space: nowrap
            }

            .local-status .org-dot {
                width: 6px;
                height: 6px
            }

            .server-save-status {
                padding-left: 5px;
                color: #537b70
            }

            .server-save-status[data-state=saving],.server-save-status[data-state=waiting] {
                color: #9b742c
            }

            .server-save-status[data-state=error] {
                color: #b64c4c
            }

            .user-menu {
                display: flex;
                align-items: center;
                gap: 8px;
                padding-left: 13px;
                border-left: 1px solid var(--line)
            }

            .avatar {
                width: 34px;
                height: 34px;
                display: grid;
                place-items: center;
                border-radius: 10px;
                background: #def0ec;
                color: #176d66;
                font-size: 11px;
                font-weight: 800
            }

            .user-label {
                font-size: 11px;
                font-weight: 700;
                color: #44575c
            }

            .user-role {
                display: block;
                color: var(--muted);
                font-size: 9px;
                font-weight: 500
            }

            .content {
                max-width: 1600px;
                margin: 0 auto;
                padding: 30px clamp(18px,3vw,40px) 54px
            }

            .page-heading {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 18px;
                margin-bottom: 22px
            }

            .page-heading h1 {
                margin: 3px 0 4px;
                font-size: 26px;
                line-height: 1.2;
                letter-spacing: -.045em;
                color: #21363a
            }

            .page-heading p {
                margin: 0;
                color: var(--muted);
                font-size: 12px
            }

            .eyebrow {
                color: var(--brand);
                font-size: 9px;
                letter-spacing: .13em;
                text-transform: uppercase;
                font-weight: 800
            }

            .heading-actions {
                display: flex;
                gap: 8px;
                flex-wrap: wrap
            }

            .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                min-height: 37px;
                padding: 8px 12px;
                border: 1px solid #dce5e6;
                border-radius: 8px;
                background: #fff;
                color: #3d5055;
                font-size: 11px;
                font-weight: 700;
                transition: transform .14s,background .14s,border-color .14s,box-shadow .14s
            }

            .btn:hover {
                background: #f5f9f9;
                border-color: #c7d7d8;
                box-shadow: 0 4px 12px #173a3d10
            }

            .btn:active {
                transform: translateY(1px)
            }

            .btn.primary {
                background: var(--brand);
                border-color: var(--brand);
                color: #fff
            }

            .btn.primary:hover {
                background: var(--brand-dark);
                border-color: var(--brand-dark)
            }

            .btn.soft {
                background: var(--brand-soft);
                border-color: #d2e7e2;
                color: var(--brand)
            }

            .btn.danger {
                color: #a64747;
                background: #fff;
                border-color: #f0d5d5
            }

            .btn.small {
                min-height: 29px;
                padding: 5px 8px;
                font-size: 10px
            }

            button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible {
                outline: 3px solid #51b7a766;
                outline-offset: 2px
            }

            .kpi-grid {
                display: grid;
                grid-template-columns: repeat(4,minmax(0,1fr));
                gap: 12px;
                margin-bottom: 16px
            }

            .kpi {
                position: relative;
                overflow: hidden;
                min-width: 0;
                padding: 16px 17px;
                border: 1px solid var(--line);
                border-radius: 12px;
                background: var(--surface);
                box-shadow: var(--shadow)
            }

            .kpi:after {
                content: "";
                position: absolute;
                right: -15px;
                top: -25px;
                width: 76px;
                height: 76px;
                border-radius: 50%;
                background: var(--brand-soft);
                opacity: .8
            }

            .kpi-top {
                position: relative;
                z-index: 1;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 8px;
                color: #66787d;
                font-size: 10px;
                font-weight: 650
            }

            .kpi-icon {
                width: 29px;
                height: 29px;
                display: grid;
                place-items: center;
                border-radius: 9px;
                background: var(--brand-soft);
                color: var(--brand);
                font-size: 14px
            }

            .kpi-value {
                position: relative;
                z-index: 1;
                display: block;
                margin-top: 8px;
                font-size: 25px;
                line-height: 1.2;
                letter-spacing: -.04em;
                font-weight: 800;
                color: #20373b;
                overflow-wrap: anywhere
            }

            .kpi-note {
                display: block;
                margin-top: 4px;
                color: #849296;
                font-size: 9px
            }

            .grid {
                display: grid;
                grid-template-columns: repeat(12,minmax(0,1fr));
                gap: 14px;
                margin-bottom: 14px
            }

            .card {
                min-width: 0;
                border: 1px solid var(--line);
                border-radius: var(--radius);
                background: var(--surface);
                box-shadow: var(--shadow);
                overflow: hidden
            }

            .span-12 {
                grid-column: span 12
            }

            .span-8 {
                grid-column: span 8
            }

            .span-7 {
                grid-column: span 7
            }

            .span-6 {
                grid-column: span 6
            }

            .span-5 {
                grid-column: span 5
            }

            .span-4 {
                grid-column: span 4
            }

            .card-head {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                padding: 15px 17px;
                border-bottom: 1px solid #edf1f1
            }

            .card-head h2,.card-head h3 {
                margin: 0;
                color: #2a3e43;
                font-size: 12px;
                font-weight: 800
            }

            .card-head p {
                margin: 3px 0 0;
                color: var(--muted);
                font-size: 10px
            }

            .card-body {
                padding: 15px 17px
            }

            .card-body.flush {
                padding: 0
            }

            .card-foot {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                padding: 10px 16px;
                border-top: 1px solid #edf1f1;
                color: var(--muted);
                font-size: 10px
            }

            .toolbar {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-wrap: wrap;
                padding: 12px 14px;
                border-bottom: 1px solid #edf1f1
            }

            .search {
                position: relative;
                flex: 1;
                min-width: 180px
            }

            .search:before {
                content: "⌕";
                position: absolute;
                top: 5px;
                left: 11px;
                color: #93a0a3;
                font-size: 17px
            }

            .search input {
                width: 100%;
                padding-left: 32px
            }

            .input,.select,.textarea,.search input {
                min-height: 36px;
                padding: 8px 10px;
                border: 1px solid #dce5e6;
                border-radius: 8px;
                background: #fff;
                color: var(--ink);
                font-size: 11px
            }

            .select {
                min-width: 135px
            }

            .textarea {
                width: 100%;
                min-height: 78px;
                resize: vertical
            }

            .input:focus,.select:focus,.textarea:focus,.search input:focus {
                border-color: #64a99e;
                box-shadow: 0 0 0 3px #1a8a7818;
                outline: 0
            }

            .input::placeholder,.textarea::placeholder,.search input::placeholder {
                color: #9aa7aa
            }

            .table-wrap {
                overflow: auto
            }

            table {
                width: 100%;
                border-collapse: separate;
                border-spacing: 0;
                min-width: 680px
            }

            th {
                position: sticky;
                top: 0;
                z-index: 1;
                padding: 11px 13px;
                background: #f6f8f8;
                border-bottom: 1px solid var(--line);
                color: #6b7b80;
                text-align: left;
                text-transform: uppercase;
                letter-spacing: .07em;
                font-size: 9px;
                font-weight: 800;
                white-space: nowrap
            }

            td {
                padding: 11px 13px;
                border-bottom: 1px solid #edf1f1;
                color: #46585d;
                font-size: 10px;
                vertical-align: middle
            }

            tbody tr:hover {
                background: #f7fbfa
            }

            tbody tr:last-child td {
                border-bottom: 0
            }

            .cell-title {
                display: block;
                color: #2b4146;
                font-weight: 750;
                font-size: 10px
            }

            .cell-sub {
                display: block;
                margin-top: 2px;
                color: #879599;
                font-size: 9px
            }

            .code {
                font-family: ui-monospace,SFMono-Regular,Consolas,monospace;
                color: #718488;
                font-size: 9px
            }

            .table-actions {
                display: flex;
                align-items: center;
                gap: 5px;
                white-space: nowrap
            }

            .icon-btn {
                width: 28px;
                height: 28px;
                display: inline-grid;
                place-items: center;
                border: 1px solid transparent;
                border-radius: 7px;
                background: transparent;
                color: #718287;
                font-size: 12px
            }

            .icon-btn:hover {
                background: #edf5f3;
                color: var(--brand);
                border-color: #dcebe7
            }

            .inline-status {
                min-width: 105px;
                min-height: 30px;
                padding: 5px;
                font-size: 9px
            }

            .empty {
                padding: 32px 16px;
                text-align: center;
                color: #849195
            }

            .empty-icon {
                width: 40px;
                height: 40px;
                display: grid;
                place-items: center;
                margin: 0 auto 9px;
                border-radius: 12px;
                background: #eff4f4;
                color: #789093;
                font-size: 18px
            }

            .empty strong {
                display: block;
                color: #46585d;
                font-size: 11px;
                margin-bottom: 3px
            }

            .empty p {
                margin: 0;
                font-size: 10px
            }

            .badge {
                display: inline-flex;
                align-items: center;
                gap: 5px;
                padding: 4px 8px;
                border-radius: 20px;
                background: #edf1f2;
                color: #617176;
                font-size: 9px;
                font-weight: 750;
                white-space: nowrap
            }

            .badge:before {
                content: "";
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: currentColor;
                opacity: .75
            }

            .badge.green {
                background: #e5f3ee;
                color: #26775f
            }

            .badge.amber {
                background: #fff3de;
                color: #94641b
            }

            .badge.red {
                background: #fbe9e9;
                color: #a74747
            }

            .badge.blue {
                background: #e9f0fb;
                color: #496b9a
            }

            .badge.violet {
                background: #f0eafa;
                color: #70519b
            }

            .badge.gray {
                background: #eef1f2;
                color: #68777b
            }

            .bar-list {
                display: grid;
                gap: 12px
            }

            .bar-line {
                display: grid;
                grid-template-columns: minmax(90px,135px) 1fr auto;
                align-items: center;
                gap: 10px;
                color: #586b70;
                font-size: 10px
            }

            .bar-track {
                height: 8px;
                overflow: hidden;
                border-radius: 8px;
                background: #edf2f2
            }

            .bar-fill {
                height: 100%;
                border-radius: 8px;
                background: linear-gradient(90deg,#198879,#64c0ad);
                min-width: 2px
            }

            .bar-count {
                color: #364c50;
                font-weight: 800;
                font-variant-numeric: tabular-nums
            }

            .budget-progress {
                display: flex;
                align-items: center;
                gap: 8px;
                min-width: 130px
            }

            .budget-track {
                height: 8px;
                flex: 1;
                overflow: hidden;
                border-radius: 8px;
                background: var(--line)
            }

            .budget-fill {
                height: 100%;
                border-radius: 8px;
                background: linear-gradient(90deg,#198879,#64c0ad)
            }

            .budget-progress small {
                min-width: 35px;
                text-align: right;
                color: var(--muted);
                font-size: 9px;
                font-weight: 750
            }

            .quick-actions {
                display: grid;
                grid-template-columns: repeat(4,minmax(0,1fr));
                gap: 9px
            }

            .quick-action {
                display: flex;
                align-items: center;
                gap: 10px;
                min-height: 56px;
                padding: 10px;
                border: 1px solid var(--line);
                border-radius: 10px;
                background: var(--surface-2);
                text-align: left;
                color: #31484c
            }

            .quick-action:hover {
                border-color: #b7d8d1;
                background: #f1f8f6
            }

            .quick-icon {
                width: 31px;
                height: 31px;
                display: grid;
                place-items: center;
                border-radius: 9px;
                background: var(--brand-soft);
                color: var(--brand);
                font-size: 14px;
                flex: none
            }

            .quick-action strong {
                display: block;
                font-size: 10px
            }

            .quick-action small {
                display: block;
                margin-top: 2px;
                color: var(--muted);
                font-size: 9px
            }

            .notice {
                display: flex;
                align-items: flex-start;
                gap: 10px;
                padding: 12px 14px;
                border: 1px solid #e8dfc9;
                border-radius: 10px;
                background: #fff9eb;
                color: #765d31;
                font-size: 10px
            }

            .notice b {
                display: block;
                margin-bottom: 2px
            }

            .notice .notice-icon {
                font-size: 14px
            }

            .form-grid {
                display: grid;
                grid-template-columns: repeat(2,minmax(0,1fr));
                gap: 12px
            }

            .password-entry {
                display: flex;
                gap: 7px
            }


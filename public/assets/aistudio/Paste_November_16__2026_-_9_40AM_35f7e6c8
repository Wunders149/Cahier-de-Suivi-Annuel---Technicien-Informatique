                }

                .grid {
                    gap: 10px;
                    margin-bottom: 10px
                }

                .card-head {
                    padding: 13px
                }

                .card-body {
                    padding: 13px
                }

                .card-body.flush {
                    padding: 0
                }

                .toolbar {
                    padding: 10px;
                    gap: 7px
                }

                .search {
                    flex-basis: 100%;
                    min-width: 0
                }

                .toolbar .select {
                    flex: 1;
                    min-width: 0
                }

                .quick-actions {
                    grid-template-columns: 1fr 1fr
                }

                .welcome {
                    align-items: flex-start;
                    padding: 15px
                }

                .welcome h1 {
                    font-size: 20px
                }

                .welcome-mark {
                    width: 42px;
                    height: 42px
                }

                .form-grid,.settings-grid {
                    grid-template-columns: 1fr
                }

                .field.full {
                    grid-column: auto
                }

                .modal-content {
                    padding: 14px
                }

                .modal-head {
                    padding: 14px
                }

                .form-actions .btn {
                    flex: 1
                }

                .bar-line {
                    grid-template-columns: 90px 1fr auto;
                    gap: 7px
                }

                .toast {
                    left: 12px;
                    right: 12px;
                    bottom: 12px;
                    text-align: center
                }
            }


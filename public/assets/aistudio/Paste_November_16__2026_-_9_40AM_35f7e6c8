                        let slug = key.normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 55) || "service"
                          , id = "dept-legacy-" + slug
                          , suffix = 2;

                    });
                    linkedEntities.forEach(function(key) {
                        base[key] = (base[key] || []).map(function(row) {
                            if (!row || typeof row !== "object")
                                return row;
                            const named = lookup.get(departmentLookupKey(row.department))
                              , current = base.departments.find(function(department) {
                                return department && String(department.id) === String(row.departmentId || "")
                            })
                              , department = current || named;
                            if (!department || String(row.departmentId || "") === String(department.id) && ((key !== "employees") || String(row.department || "") === String(department.name)))
                                return row;

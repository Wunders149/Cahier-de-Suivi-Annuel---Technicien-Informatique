{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil de l'utilisateur ou du technicien informatique",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "role": { "type": "string", "enum": ["admin", "technician", "viewer"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "email", "role"]
    },
    "Workbook": {
      "title": "Workbook",
      "description": "Cahier de suivi annuel complet du technicien informatique",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "format": "email", "maxLength": 254 },
        "annee": { "type": "number" },
        "generalInfo": { "type": "object" },
        "objectifsAnnuels": { "type": "array" },
        "jalonsCalendrier": { "type": "array" },
        "journalTaches": { "type": "array" },
        "interventions": { "type": "array" },
        "maintenances": { "type": "array" },
        "reseauEquipements": { "type": "array" },
        "reseauIncidents": { "type": "array" },
        "reseauTestsDebit": { "type": "array" },
        "parcEquipements": { "type": "array" },
        "logicielsLicences": { "type": "array" },
        "sauvegardes": { "type": "array" },
        "incidentsSecurite": { "type": "array" },
        "consommables": { "type": "array" },
        "demandesAchat": { "type": "array" },
        "rapportsMensuels": { "type": "array" },
        "bilansTrimestriels": { "type": "array" },
        "bilanAnnuel": { "type": "object" },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "updatedAt"]
    },
    "WorkbookArchive": {
      "title": "WorkbookArchive",
      "description": "Snapshot figé d'un exercice annuel clôturé (multi-année)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workbookId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "annee": { "type": "number" },
        "archivedAt": { "type": "string", "maxLength": 64 },
        "summaryStats": { "type": "object" },
        "data": { "type": "object" }
      },
      "required": ["id", "workbookId", "userId", "annee", "archivedAt", "data"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Données de profil utilisateur"
    },
    "workbooks/{workbookId}": {
      "schema": "Workbook",
      "description": "Cahiers de suivi annuel informatiques actifs"
    },
    "workbooks/{workbookId}/archives/{archiveYear}": {
      "schema": "WorkbookArchive",
      "description": "Archives annuelles clôturées par exercice pour support multi-année"
    }
  }
}
